<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>나래싱크</string>
	<key>CFBundleName</key>
	<string>NaraeSync</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- HealthKit 사용 목적 설명 (사용자 권한 요청 시 표시됨) -->
	<key>NSHealthShareUsageDescription</key>
	<string>가민에서 기록한 달리기를 읽어 Strava로 자동 업로드하기 위해 건강 데이터 읽기 권한이 필요합니다.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>이 앱은 건강 데이터를 쓰지 않지만 시스템 요구사항으로 포함됩니다.</string>

	<!-- Strava OAuth 콜백용 커스텀 URL scheme -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.example.naraesync.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>naraesync</string>
			</array>
		</dict>
	</array>

	<key>UILaunchScreen</key>
	<dict/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
